# Copy to .env (git-ignored) and fill in. Generate each value with
#   openssl rand -hex 32
# DB_PASSWORD only takes effect on a fresh database volume; for an existing one,
# change the password inside Postgres as well (README, "Changing the database password").
DB_PASSWORD=
# Carried by the study builds of both apps (header X-Study-Token).
STUDY_WRITE_TOKEN=
# Only for reading the records (analysis, export). Never put it in an app.
STUDY_READ_TOKEN=
